# 运行期数据（不入库）
dispatch/work/
dispatch/.data/
.data/
node_modules/
# OpenCode 执行器（collab-kit/opencode-run.mjs）与 ZCode 执行器一样，把产物落在
# **工作目录**下的 collab/logs/。若派发的工作目录恰好是本仓库（测试/自派发场景），
# 就会在这里生成 collab/ ⇒ 那是运行期产物，不入库。
# ⚠️ 只忽略 logs 子目录：将来若要随仓库发货 collab/ 下的文档不会被误伤。
collab/logs/
dispatch/collab/logs/

# 桥的运行时收发（只保留目录占位）
bridge/inbox/*
bridge/outbox/*
bridge/archive/*
!bridge/inbox/.gitkeep
!bridge/outbox/.gitkeep
!bridge/archive/.gitkeep

# 第三方（DSH 自带）材料的提取副本：不入库，来源与再生成方式见 refs/README.md
refs/SKILL.md
refs/references/
refs/templates/
refs/extracted/
refs/dsh-typert/
refs/dsh-plugin-manager/
refs/dsh-pm-ui/
refs/dsh-host-cli/

# 临时/日志
*.log
*.tmp
%TEMP%

# 第三方可用样例（只读参考，不入库）：profile 里已安装的 whale-pet 插件
refs/plugin-whale-pet/

# 备份/临时文件（本地改动时的 .bak-日期，不入库）
*.bak
*.bak-*
*.orig
*.rej

# 审查工具生成的临时产物（2026-10-26 全面审查）
test/.review-runtime/
test/.npm-review-cache/

