{
  "name": "dsh-dispatch",
  "version": "0.1.0",
  "type": "module",
  "description": "在 DeepSeek Harness 里派发/监视多个 AI CLI 无头进程（ZCode / OpenCode / Qoder / WorkBuddy 四引擎）：单写者互斥、用量与上下文聚合、并发与降级链、分流、暂停分类与 WorkBuddy 登录助手",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuffle-1992/dsh-dispatch.git",
    "directory": "dispatch"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "zcode",
    "dispatch",
    "subagent",
    "agent-tool",
    "cordis",
    "client-plugin"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": "./wire.host.mjs",
    "./remote": "./wire.client.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "DSH 派发台",
    "description": "在 Harness 里派发/监视多个 AI CLI 无头进程（ZCode / OpenCode / Qoder / WorkBuddy 四引擎）：单写者互斥、用量与上下文、并发与降级链、WorkBuddy 登录"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "notify.mjs",
    "bin",
    "core",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "wire.host.mjs",
    "wire.client.mjs"
  ]
}
