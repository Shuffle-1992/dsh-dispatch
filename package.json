{
  "name": "dsh-dispatch",
  "version": "0.1.0",
  "description": "在 DeepSeek Harness 里派发/监视多个 ZCode 无头进程：单写者互斥、用量与上下文聚合、套餐通道与自动降级",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuffle-1992/zcode-dispatch.git"
  },
  "homepage": "https://github.com/Shuffle-1992/zcode-dispatch",
  "bugs": {
    "url": "https://github.com/Shuffle-1992/zcode-dispatch/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "dsh",
    "zcode",
    "dispatch",
    "subagent",
    "agent-tool",
    "client-plugin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./dispatch/index.js",
    "./client": "./dispatch/client.js",
    "./typert": "./dispatch/wire.host.mjs",
    "./remote": "./dispatch/wire.client.mjs",
    "./locale/*.json": "./dispatch/locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dispatch/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "DSH 派发台",
    "description": "在 Harness 里派发/监视多个 ZCode 无头进程（单写者互斥、用量与上下文、套餐通道）"
  },
  "icon": "./dispatch/icon.svg",
  "files": [
    "dispatch/index.js",
    "dispatch/client.js",
    "dispatch/notify.mjs",
    "dispatch/wire.host.mjs",
    "dispatch/wire.client.mjs",
    "dispatch/cordis.patch.yml",
    "dispatch/icon.svg",
    "dispatch/README.md",
    "dispatch/bin",
    "dispatch/core",
    "dispatch/locale",
    "README.md",
    "LICENSE"
  ]
}
